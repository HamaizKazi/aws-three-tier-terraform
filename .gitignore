# ==========================================
# TERRAFORM
# ==========================================

# Downloaded providers and modules
.terraform/

# State files, backups, and state locks
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Local variable values
*.tfvars
*.tfvars.json

# Saved plans and exported plan contents
*.tfplan
*.tfplan.*
*.plan
tfplan
plan.out
deployment-plan.txt
deployment-plan.json
deploy-plan.txt
deploy-plan.json

# Local Terraform overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration (may contain tokens)
.terraformrc
terraform.rc

# Crash logs
crash.log
crash.*.log

# Keep .terraform.lock.hcl tracked for reproducible providers


# ==========================================
# CREDENTIALS & SENSITIVE FILES
# ==========================================

.aws/
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
*.ppk

secrets/
credentials
credentials.json


# ==========================================
# GENERATED REPORTS
# ==========================================

reports/*
!reports/.gitkeep


# ==========================================
# DEVELOPMENT ENVIRONMENT
# ==========================================

__pycache__/
*.py[cod]
.venv/
venv/
.idea/

.DS_Store
Thumbs.db
desktop.ini